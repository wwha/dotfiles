Include ~/.ssh/config.local
# Include ~/.orbstack/ssh/config
# Enforce key-based authentication
PubkeyAuthentication yes

Host *
  AddKeysToAgent yes
  UseKeychain yes
  ServerAliveInterval 30
  ServerAliveCountMax 3

Match command ""
  RequestTTY yes
  RemoteCommand $SHELL -l -c "tmux new-session -A -s main"
