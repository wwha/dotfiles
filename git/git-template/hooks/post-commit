#!/bin/zsh

# Colors for output
autoload -U colors && colors

# Get the commit message
commit_msg=$(git log -1 HEAD --pretty=format:%s)

# Show macOS notification
if command -v osascript &>/dev/null; then
    osascript - "$commit_msg" <<'APPLESCRIPT'
on run argv
    display notification (item 1 of argv) with title "Git Commit" subtitle "✓ Commit Successful"
end run
APPLESCRIPT
fi

# Print success message
echo "$fg[green]Commit successful:$reset_color $commit_msg"
